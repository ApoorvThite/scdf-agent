# ─── OpenAI — routed through Helicone proxy ───────────────────────────────────
OPENAI_API_KEY=sk-...
HELICONE_API_KEY=sk-helicone-...

# ─── Model assignments (tiered cost strategy) ─────────────────────────────────
# PRIMARY  → gpt-4o-mini  (signal ingestion, retrieval, playbook formatting)
# DEBATE   → gpt-4o       (bull/bear analyst agents only — highest reasoning)
# FAST     → gpt-4o-mini  (any sub-second classification calls)
MODEL_PRIMARY=gpt-4o-mini
MODEL_DEBATE=gpt-4o
MODEL_FAST=gpt-4o-mini

# ─── Helicone proxy base URL ──────────────────────────────────────────────────
# Drop-in replacement for https://api.openai.com/v1
# All LLM calls MUST go through this URL for cost tracking
HELICONE_BASE_URL=https://oai.helicone.ai/v1

# ─── Qdrant (local Docker, see docker-compose.yml) ───────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_DISRUPTIONS=disruptions
QDRANT_COLLECTION_RESPONSES=responses
QDRANT_COLLECTION_PLAYBOOKS=playbooks

# ─── Langfuse (local Docker self-hosted, see docker-compose.yml) ──────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# ─── Upstash Redis Streams (signal bus — Kinesis substitute, free tier) ───────
UPSTASH_REDIS_URL=rediss://...
UPSTASH_REDIS_TOKEN=...

# ─── AWS (always-free tier resources) ─────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
DYNAMODB_TABLE_DISRUPTIONS=scdf-disruptions
# DYNAMODB_ENDPOINT_URL=http://localhost:8000  # Uncomment for local DynamoDB / LocalStack
S3_BUCKET_PLAYBOOKS=scdf-playbooks
SNS_TOPIC_CRITICAL=arn:aws:sns:us-east-1:...:scdf-critical
SNS_TOPIC_STANDARD=arn:aws:sns:us-east-1:...:scdf-standard

# ─── Project metadata ─────────────────────────────────────────────────────────
PROJECT_NAME=scdf-agent
ENVIRONMENT=development
LOG_LEVEL=INFO
